From 3734217b811aab14cbafbddbae9f4d31f4036bdb Mon Sep 17 00:00:00 2001
From: isyourbrainfoss <isyourbrainfoss@proton.me>
Date: Tue, 13 Oct 2026 08:33:06 +0200
Subject: [PATCH 1/3] dt-bindings: iio: proximity: document the ST VL53L3CX

The VL53L3CX is an ST FlightSense ranger on I2C. It uses the same
16-bit register map family as the VL53L1X, but its model id is 0xEAAA
rather than 0xEACC, and the VL53L1X configuration does not range it.

Add a compatible to the existing binding and require vdd-supply, as
for the VL53L1X. XSHUT stays an optional reset-gpios, active low.

Signed-off-by: isyourbrainfoss <isyourbrainfoss@proton.me>
---
 .../bindings/iio/proximity/st,vl53l0x.yaml    | 33 +++++++++++++++++--
 1 file changed, 31 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/iio/proximity/st,vl53l0x.yaml b/Documentation/devicetree/bindings/iio/proximity/st,vl53l0x.yaml
index f7f8be1e3..dfe30360c 100644
--- a/Documentation/devicetree/bindings/iio/proximity/st,vl53l0x.yaml
+++ b/Documentation/devicetree/bindings/iio/proximity/st,vl53l0x.yaml
@@ -4,17 +4,26 @@
 $id: http://devicetree.org/schemas/iio/proximity/st,vl53l0x.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: ST VL53L0X/VL53L1X ToF ranging sensor
+title: ST VL53L0X/VL53L1X/VL53L3CX ToF ranging sensor
 
 maintainers:
   - Song Qiang <songqiang1304521@gmail.com>
   - Siratul Islam <email@sirat.me>
 
+description: |
+  ST FlightSense time-of-flight sensors on I2C, default address 0x29.
+
+  The VL53L0X uses an 8-bit register map. The VL53L1X and VL53L3CX use a
+  16-bit map. A VL53L1X reports model id 0xEACC. A VL53L3CX reports model
+  id 0xEAAA and needs its own driver. The VL53L1X configuration does not
+  range it.
+
 properties:
   compatible:
     enum:
       - st,vl53l0x
       - st,vl53l1x
+      - st,vl53l3cx
 
   reg:
     maxItems: 1
@@ -38,7 +47,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: st,vl53l1x
+            enum:
+              - st,vl53l1x
+              - st,vl53l3cx
     then:
       required:
         - vdd-supply
@@ -60,4 +71,22 @@ examples:
             interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
         };
     };
+
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        proximity@29 {
+            compatible = "st,vl53l3cx";
+            reg = <0x29>;
+            vdd-supply = <&reg_2v8>;
+            interrupt-parent = <&gpio>;
+            interrupts = <48 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&gpio 49 GPIO_ACTIVE_LOW>;
+        };
+    };
 ...
-- 
